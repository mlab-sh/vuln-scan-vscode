{
  "name": "vuln-scan",
  "displayName": "mlab security",
  "description": "CVE scanning for your lockfiles, powered by mlab. Nothing is uploaded until you agree once; after that, changed lockfiles are rescanned automatically and results are cached per content.",
  "version": "1.0.2",
  "publisher": "mlab-sh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mlab-sh/vuln-scan-vscode.git"
  },
  "homepage": "https://vuln.mlab.sh",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "security",
    "vulnerabilities",
    "cve",
    "sbom",
    "lockfile"
  ],
  "icon": "resources/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/{Cargo.lock,package-lock.json,npm-shrinkwrap.json,composer.lock,Gemfile.lock,go.sum,requirements.txt,mise.lock}"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Scanning is disabled in Restricted Mode because it sends the lockfile's contents to vuln.mlab.sh. Trust this workspace to enable scanning."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "mlab.checkLockfile",
        "title": "Check for lock vulnerabilities",
        "category": "mlab"
      },
      {
        "command": "mlab.showReport",
        "title": "See vuln report",
        "category": "mlab",
        "icon": "$(output)"
      },
      {
        "command": "mlab.scanWorkspace",
        "title": "Scan all lockfiles in workspace",
        "category": "mlab"
      },
      {
        "command": "mlab.clearResults",
        "title": "Clear results",
        "category": "mlab",
        "icon": "$(clear-all)"
      },
      {
        "command": "mlab.setToken",
        "title": "Set API token",
        "category": "mlab"
      },
      {
        "command": "mlab.clearToken",
        "title": "Clear API token",
        "category": "mlab"
      },
      {
        "command": "mlab.analyzeSelection",
        "title": "Analyze selection",
        "category": "mlab",
        "icon": "$(search)"
      },
      {
        "command": "mlab.openHome",
        "title": "Open mlab",
        "category": "mlab",
        "icon": "$(home)"
      },
      {
        "command": "mlab.manageToken",
        "title": "Manage API token & quota",
        "category": "mlab"
      },
      {
        "command": "mlab.rescan",
        "title": "Rescan",
        "category": "mlab",
        "icon": "$(refresh)"
      },
      {
        "command": "mlab.openLockfile",
        "title": "Open lockfile",
        "category": "mlab"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mlab.showReport",
          "when": "resourceFilename =~ /^(Cargo\\.lock|package-lock\\.json|npm-shrinkwrap\\.json|composer\\.lock|Gemfile\\.lock|go\\.sum|requirements\\.txt|mise\\.lock)$/i",
          "group": "2_workspace@99"
        },
        {
          "command": "mlab.checkLockfile",
          "when": "resourceFilename =~ /^(Cargo\\.lock|package-lock\\.json|npm-shrinkwrap\\.json|composer\\.lock|Gemfile\\.lock|go\\.sum|requirements\\.txt|mise\\.lock)$/i",
          "group": "2_workspace@100"
        }
      ],
      "editor/context": [
        {
          "command": "mlab.showReport",
          "when": "resourceFilename =~ /^(Cargo\\.lock|package-lock\\.json|npm-shrinkwrap\\.json|composer\\.lock|Gemfile\\.lock|go\\.sum|requirements\\.txt|mise\\.lock)$/i",
          "group": "2_workspace@99"
        },
        {
          "command": "mlab.checkLockfile",
          "when": "resourceFilename =~ /^(Cargo\\.lock|package-lock\\.json|npm-shrinkwrap\\.json|composer\\.lock|Gemfile\\.lock|go\\.sum|requirements\\.txt|mise\\.lock)$/i",
          "group": "2_workspace@100"
        },
        {
          "command": "mlab.analyzeSelection",
          "when": "editorHasSelection && mlab.analyzeSelection",
          "group": "2_workspace@98"
        }
      ],
      "view/title": [
        {
          "command": "mlab.openHome",
          "when": "view == mlab.findings",
          "group": "navigation@1"
        },
        {
          "command": "mlab.rescan",
          "when": "view == mlab.findings && mlab.hasResults",
          "group": "navigation@2"
        },
        {
          "command": "mlab.clearResults",
          "when": "view == mlab.findings && mlab.hasResults",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "mlab.rescan",
          "when": "false"
        },
        {
          "command": "mlab.openLockfile",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "mlab.showReport",
          "when": "view == mlab.findings && viewItem == mlab.file",
          "group": "inline@1"
        },
        {
          "command": "mlab.openLockfile",
          "when": "view == mlab.findings && viewItem == mlab.file",
          "group": "1_open@1"
        },
        {
          "command": "mlab.checkLockfile",
          "when": "view == mlab.findings && viewItem == mlab.file",
          "group": "1_open@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mlab",
          "title": "mlab",
          "icon": "resources/mlab-mono.png"
        }
      ]
    },
    "views": {
      "mlab": [
        {
          "id": "mlab.findings",
          "name": "Vulnerabilities",
          "icon": "resources/mlab-mono.png",
          "contextualTitle": "mlab"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mlab.findings",
        "contents": "No scan has been run yet.\n\nNothing is sent to vuln.mlab.sh until you agree once. After that, lockfiles are rescanned automatically when their contents change, and unchanged files are served from cache.\n\nRight-click a lockfile in the Explorer, or start from here.\n[Check for lock vulnerabilities](command:mlab.checkLockfile)\n[Scan all lockfiles in workspace](command:mlab.scanWorkspace)\n\nQuota, API token and settings live on the mlab page.\n[Open mlab](command:mlab.openHome)\n\nSupported lockfiles: Cargo.lock, package-lock.json, npm-shrinkwrap.json, composer.lock, Gemfile.lock, go.sum, requirements.txt, mise.lock."
      }
    ],
    "configuration": {
      "title": "mlab security",
      "properties": {
        "mlab.autoScan": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Rescan a lockfile automatically when its contents change. Results are cached per file content, so an unchanged lockfile is never re-uploaded. Nothing is ever uploaded before you have accepted the one time privacy prompt, so this setting produces no network traffic until then."
        },
        "mlab.cveHover": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show CVSS, exploitation likelihood (EPSS) and known-exploited status when you hover a CVE identifier in any file. Only the identifier is looked up, never the surrounding code, and results are cached for a day."
        },
        "mlab.analyzeSelection": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer **Analyze selection** in the editor context menu. Select a URL, IP, email, file hash or MAC address and look it up on the mlab platform. Only the selected value is sent, never the surrounding file."
        },
        "mlab.apiUrl": {
          "type": "string",
          "default": "https://vuln.mlab.sh/api/v2/scan",
          "markdownDescription": "Scan endpoint. Override this to point at a self-hosted vuln.mlab.sh instance."
        },
        "mlab.platformUrl": {
          "type": "string",
          "default": "https://mlab.sh/api/v1",
          "markdownDescription": "Base URL of the mlab platform API, used by `mlab: Analyze selection`. Override it to point at a self-hosted instance."
        },
        "mlab.severityFloor": {
          "type": "string",
          "enum": [
            "any",
            "low",
            "medium",
            "high",
            "critical"
          ],
          "default": "any",
          "markdownDescription": "Lowest severity reported as a Warning or Error in the Problems panel. At or above this floor, critical and high are Errors and the rest are Warnings; below it, findings are downgraded to Information. This tunes the diagnostic severity mapping only; it never fails anything."
        },
        "mlab.timeoutMs": {
          "type": "number",
          "default": 30000,
          "minimum": 1000,
          "markdownDescription": "Per-request timeout in milliseconds for a scan."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js --production",
    "build:dev": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "sync:manifest": "node --import tsx scripts/sync-manifest.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "package": "npm run typecheck && vsce package --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vscode/vsce": "^2.32.0",
    "esbuild": "^0.23.1",
    "eslint": "^8.57.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
